datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Usuario {
  id       Int    @id @default(autoincrement())
  email    String @unique
  nombre   String
  posts    Post[]
}

model Post {
  id        Int     @id @default(autoincrement())
  titulo    String
  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id])
}
